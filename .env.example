# ---------------------------------------------------------------------------
# XeGo - biến môi trường
# Sao chép file này thành .env rồi chỉnh theo môi trường của bạn.
# ---------------------------------------------------------------------------

# Cổng API (mặc định 4000)
PORT=4000

# Môi trường: development | production
NODE_ENV=development

# Khoá ký JWT - BẮT BUỘC đổi khi triển khai thật
JWT_SECRET=doi-khoa-nay-truoc-khi-trien-khai
JWT_EXPIRES_IN=7d

# Thư mục lưu SQLite (mặc định server/data)
# DATA_DIR=./server/data

# Tạo dữ liệu demo khi database trống (true|false)
SEED=true

# URL công khai của web, dùng để tạo link chia sẻ chuyến đi
PUBLIC_WEB_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Tích hợp bản đồ / địa chỉ / tuyến đường
# Mặc định dùng dịch vụ công khai miễn phí (OpenStreetMap + OSRM demo).
# Với lưu lượng thật, hãy đăng ký nhà cung cấp riêng và đặt URL tại đây.
# ---------------------------------------------------------------------------
GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTER_URL=https://router.project-osrm.org
GEO_USER_AGENT=XeGo/1.0 (lien-he@xego.vn)

# ---------------------------------------------------------------------------
# Thanh toán trực tuyến (chưa bật mặc định - chạy ở chế độ mô phỏng)
# Điền khi có hợp đồng với cổng thanh toán, ví dụ VNPay / MoMo / ZaloPay.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=demo
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:5173/payment/return

# ---------------------------------------------------------------------------
# SMS / OTP (chưa bật mặc định - OTP in ra log ở chế độ demo)
# ---------------------------------------------------------------------------
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_BRANDNAME=XeGo
